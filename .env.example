# Copy to .env at the repo root. Both apps read it. Defaults match docker-compose.yml.

# --- Postgres ---------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=tacit
TACIT_MIGRATOR_PASSWORD=migrator
TACIT_AUTH_PASSWORD=auth
TACIT_API_PASSWORD=api

# Alembic (owns all tables)
MIGRATOR_DATABASE_URL=postgresql+psycopg://tacit_migrator:migrator@localhost:5432/tacit
# Better Auth in Next.js (auth tables only)
AUTH_DATABASE_URL=postgresql://tacit_auth:auth@localhost:5432/tacit
# FastAPI / workers / MCP (RLS enforced)
API_DATABASE_URL=postgresql+asyncpg://tacit_api:api@localhost:5432/tacit

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# FastAPI checks JWTs against this issuer/audience and fetches keys from the JWKS URL
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=tacit-api
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Optional: GitHub sign-in (an OAuth App; separate from the connector's GitHub App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Mailpit in dev: http://localhost:8025) ---------------------------
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Tacit <no-reply@tacit.local>

# --- Web -> API ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# --- Graph (build step 4) -------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tacit-dev-password
